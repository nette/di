use:
	- nette
	- modernizations

typeAnalysis: phpstan

paths:
	- src
	- tests

excludePaths:
	- tests/**/expected
	- tests/**/fixtures*

fileExtensions:
	- php
	- phpt

imports: {grouping: {class: grouped}}

namespaces:
	functions: ['Nette\DI\{service, wire, args, self, param, expand, create, call, services, cast, not, code, serviceFrom, classFrom, imported, factory, accessor, classifyCallable}']
	constants: [Nette\DI\__]

overrides:
	-
		paths: [src]
		nameResolution: certain
		use:
			- compilerOptimizations
			- deprecations

	- # the package keeps its own deprecated API working, so it uses it
		paths:
			- src/DI/CompilerExtension.php
			- src/DI/Config/Adapters/NeonAdapter.php
			- src/DI/Config/Adapters/NeonEvaluator.php
			- src/DI/Container.php
			- src/DI/Definitions/FactoryDefinition.php
			- src/DI/Extensions/DefinitionSchema.php
			- src/DI/Extensions/DIExtension.php
			- src/DI/Compiler/PhpGenerator.php
		upgrading: {declarations: {deprecatedClass: keep, deprecatedMember: keep}}

	- # renaming the parameters would break calls naming def:
		paths: [src/DI/Extensions/DefinitionSchema.php]
		classes: {overridingMethod: {parameterName: keep}}

	- # the DSL placeholder __ echoes the _ of NEON
		paths: [src/DI/functions.php]
		naming: {constant: keep}

	- # renaming the public constant of a deprecated class would break code still using it
		paths: [src/DI/Config/Helpers.php]
		naming: {constant: keep}

	- # test classes are named after the kind they stand for
		paths:
			- tests/Expressions/Instantiation.phpt
			- tests/Expressions/validation.errors.phpt
			- tests/Extensions/Inject.basic.phpt
			- tests/Extensions/Inject.methods.phpt
			- tests/Extensions/Inject.properties.traits.phpt
		naming: {abstractClassAffix: keep, interfaceAffix: keep, traitAffix: keep}

	- # the test function shadows a native one
		paths: [tests/Compiler/ContainerLoader.opcache.phpt]
		naming: {function: keep}

	- # the class name with a leading backslash is the tested data
		paths:
			- tests/Bridges/DIPsr.phpt
			- tests/Config/functions.phpt
			- tests/ContainerBuilder/getByType.phpt
			- tests/Definitions/Accessor.api.phpt
			- tests/Definitions/Locator.api.phpt
			- tests/Extensions/Services.create.phpt
		literals: {classNameInString: keep}
