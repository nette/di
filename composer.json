{
	"name": "nette/di",
	"description": "💎 Nette DI: a dependency injection container with autowiring, configured in NEON and compiled into readable PHP code. Factories and accessors are generated from an interface alone.",
	"keywords": ["nette", "dependency injection", "di", "container", "dic", "ioc", "autowiring", "service container"],
	"homepage": "https://doc.nette.org/dependency-injection",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.1 - 8.6",
		"ext-tokenizer": "*",
		"ext-ctype": "*",
		"nette/neon": "^3.4",
		"nette/php-generator": "^4.1.6",
		"nette/robot-loader": "^4.0",
		"nette/schema": "^1.2.5",
		"nette/utils": "^4.0.6"
	},
	"require-dev": {
		"nette/tester": "^2.6",
		"tracy/tracy": "^2.9",
		"psr/container": "^1.1 || ^2.0",
		"phpstan/phpstan": "^2.1@stable",
		"phpstan/extension-installer": "^1.4@stable",
		"nette/phpstan-rules": "^1.0"
	},
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"Nette\\": "src"
		}
	},
	"minimum-stability": "dev",
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.2-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
